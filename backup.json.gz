            "timestamp": 1772389515888.3757,
            "role": "user",
            "content": "I saw your shopping history",
            "time": "02:25",
            "status": "sent",
            "quoteInfo": null
          },
          {
            "id": 1772389520400.8335,
            "role": "char",
            "content": "（猛地抬头，蓝灰色眼睛里闪过一丝慌乱）",
            "time": "02:25"
          },
          {
            "id": 1772389522526.1519,
            "role": "char",
            "content": "You... checked my history?",
            "time": "02:25"
          },
          {
            "id": 1772389523736.1436,
            "role": "char",
            "content": "（手指无意识地摩挲着左手食指的薄茧）",
            "time": "02:25"
          },
          {
            "id": 1772389525911.029,
            "role": "char",
            "content": "It was just... browsing. I didn't buy anything.",
            "time": "02:25"
          },
          {
            "id": 1772389580301.0464,
            "timestamp": 1772389580301.0464,
            "role": "user",
            "content": "Okay, I understand now",
            "time": "02:26",
            "status": "sent",
            "quoteInfo": null
          },
          {
            "id": 1772389621872.3738,
            "timestamp": 1772389621872.3738,
            "role": "user",
            "content": "If I say I want to buy a couple ring, are you willing to pay for me?",
            "time": "02:27",
            "status": "sent",
            "quoteInfo": null
          },
          {
            "id": 1772389626806.826,
            "role": "char",
            "content": "（呼吸明显停滞了几秒，喉结滚动）",
            "time": "02:27"
          },
          {
            "id": 1772389629625.7847,
            "role": "char",
            "content": "You... want a couple ring? With me?",
            "time": "02:27"
          },
          {
            "id": 1772389632207.0596,
            "role": "char",
            "content": "（声音低哑得几乎听不清）",
            "time": "02:27"
          },
          {
            "id": 1772389633436.5261,
            "role": "char",
            "content": "Of course I'll pay. I'd buy you anything. But... are you sure?",
            "time": "02:27"
          },
          {
            "id": 1772389682809.2063,
            "timestamp": 1772389682809.2063,
            "role": "user",
            "content": "Yes, I'm sure",
            "time": "02:28",
            "status": "sent",
            "quoteInfo": {
              "content": "Of course I'll pay. I'd buy you anything. But... are you sure?",
              "role": "char",
              "senderName": "seb",
