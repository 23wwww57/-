              }
            },
            {
              "id": 1773062873321.514,
              "role": "char",
              "content": "(His breath catches. The word “调情” hangs in the air, foreign and intimate. He rubs a hand over his face, the frustration melting into something more vulnerable)",
              "time": "21:27",
              "type": "chat",
              "source": "main-reply"
            },
            {
              "id": 1773062875642.976,
              "role": "char",
              "content": "You... were trying to flirt? (His voice is low, disbelieving) With me?",
              "time": "21:27",
              "type": "chat",
              "source": "main-reply"
            },
            {
              "id": 1773062877290.221,
