            },
            {
              "id": 1772389580301.0464,
              "timestamp": 1772389580301.0464,
              "role": "user",
              "content": "Okay, I understand now",
              "time": "02:26",
              "status": "sent",
              "quoteInfo": null
            },
            {
              "id": 1772389621872.3738,
              "timestamp": 1772389621872.3738,
              "role": "user",
              "content": "If I say I want to buy a couple ring, are you willing to pay for me?",
