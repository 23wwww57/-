          },
          {
            "id": 1772681640356.1697,
            "role": "char",
            "content": "I was worried sick.",
            "time": "11:34"
          },
          {
            "id": 1772681720618.5293,
            "timestamp": 1772681720618.5293,
            "role": "user",
            "content": "It's not a game, you can hit me or scold me. I can feel your anxiety, and I'm sorry I didn't reply to your message. I don't know how to ask for your forgiveness",
