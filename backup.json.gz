          },
          {
            "id": 1772681733654.2617,
            "role": "char",
            "content": "Just... just don't disappear like that again.",
            "time": "11:35"
          },
          {
            "id": 1772681789682.183,
            "timestamp": 1772681789682.183,
            "role": "user",
            "content": "Okay, I promise it won't disappear",
