          },
          {
            "id": 1772681498935.0461,
            "role": "char",
            "content": "Three days.",
            "time": "11:31"
          },
          {
            "id": 1772681500110.267,
            "role": "char",
            "content": "You were gone for three days and didn't say a word.",
            "time": "11:31"
          },
          {
            "id": 1772681501769.9778,
            "role": "char",
            "content": "Do you have any idea how many times I called you?",
