            "timestamp": 1772811775231.0808,
            "role": "user",
            "content": "Dear, you are so lovely. You have had another fulfilling day",
            "time": "23:42",
            "status": "sent",
            "quoteInfo": {
              "content": "Can't sleep. Thinking about... physics.",
              "role": "char",
