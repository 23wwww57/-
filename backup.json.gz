            "transferId": "trans_1772389100975_wdo5l"
          },
          {
            "id": 1772389100985.6104,
            "role": "char",
            "content": "（深吸一口气，手指在屏幕上停顿了几秒）",
            "time": "02:18"
          },
          {
            "id": 1772389102328.9058,
            "role": "char",
            "content": "That's almost half your monthly salary.",
            "time": "02:18"
          },
          {
            "id": 1772389104006.5574,
            "role": "char",
            "content": "（语气低沉）",
            "time": "02:18"
          },
          {
            "id": 1772389105658.7273,
            "role": "char",
            "content": "I'm transferring it to you. Don't ever do this again.",
            "time": "02:18"
          },
          {
            "id": 1772389113732.1394,
            "role": "char",
            "content": "（转账已收到）",
            "time": "02:18"
          },
          {
            "id": 1772389114922.5825,
            "role": "char",
            "content": "It's not about the money.",
            "time": "02:18"
          },
          {
            "id": 1772389116699.1233,
            "role": "char",
            "content": "（停顿片刻，声音压得更低）",
            "time": "02:18"
          },
          {
            "id": 1772389119343.4912,
            "role": "char",
            "content": "I don't want you spending your hard-earned money on me. You need it more than I do.",
            "time": "02:18"
          },
          {
            "id": 1772389169359.1245,
            "timestamp": 1772389169359.1245,
            "role": "user",
            "content": "Okay, I love you, baby. You always think of me like this",
            "time": "02:19",
            "status": "sent",
            "quoteInfo": {
              "content": "I don't want you spending your hard-earned money on me. You need it more than I do.",
              "role": "char",
              "senderName": "seb",
              "originalIndex": 120
            }
          },
          {
            "id": 1772389388739.1763,
            "role": "char",
            "content": "（听到“I love you”时呼吸明显一滞，手指收紧）",
            "time": "02:23"
          },
          {
            "id": 1772389390799.9792,
            "role": "char",
            "content": "Don't say that.",
            "time": "02:23"
          },
          {
            "id": 1772389392203.4946,
            "role": "char",
            "content": "（声音有些发紧）",
            "time": "02:23"
          },
          {
            "id": 1772389394295.088,
            "role": "char",
            "content": "Not when I'm... like this. Not when I'm being an asshole about money.",
            "time": "02:23"
          },
          {
            "id": 1772389498058.352,
            "timestamp": 1772389498058.352,
            "role": "user",
            "content": "Have you bought a couple's ring?",
